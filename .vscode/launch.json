{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Expo",
      "type": "node",
      "request": "attach",
      "port": 8081,
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${workspaceRoot}/node_modules/*",
        "webpack:///./*": "${workspaceRoot}/*",
        "webpack:///*": "*"
      }
    }
  ]
}
