{
  "_comment": "RS-R Remote Android release signing credentials (EAS Local Build 用). プロジェクトルートに `credentials.json` としてコピーして使う (EAS CLI がルート固定で読むため). 実ファイルは gitignore 済み.",
  "android": {
    "keystore": {
      "keystorePath": "/absolute/path/to/your.keystore",
      "keystorePassword": "your-keystore-password",
      "keyAlias": "your-key-alias",
      "keyPassword": "your-key-password"
    }
  }
}
