{
  "name": "rsr-remote-react-native",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check:cycles": "madge --circular --extensions ts,tsx src/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" App.js index.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" App.js index.js",
    "check:debug-logs": "node build-config/check-debug-logs.js",
    "generate:licenses": "node build-config/generate-licenses.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@notifee/react-native": "^9.1.8",
    "@react-navigation/native": "^7.3.0",
    "@react-navigation/native-stack": "^7.17.2",
    "@resvg/resvg-js": "^2.6.2",
    "expo": "~56.0.9",
    "expo-build-properties": "~56.0.17",
    "expo-dev-client": "~56.0.19",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-localization": "~56.0.6",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "i18next": "^26.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-iap": "^15.3.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-vlc-media-player": "^1.0.98",
    "react-native-web": "^0.21.0",
    "react-native-wifi-reborn": "^4.13.6",
    "zustand": "^5.0.14"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.2.17",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "madge": "^8.0.0",
    "prettier": "3.9.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  }
}
